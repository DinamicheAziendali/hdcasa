<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="amazon_awd_inbound_shipment_search_view" model="ir.ui.view">
        <field name="name">Amazon AWD inbound shipment Search</field>
        <field name="model">awd.inbound.shipment.ept</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Inbound Shipment">
                <field name="name"/>
                <field name="ship_from_address_id"/>
                <field name="destination_address_id"/>
                <field name="instance_id_ept"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record id="amazon_awd_inbound_shipment_tree_view" model="ir.ui.view">
        <field name="name">amazon.awd.inbound.shipment.tree.view</field>
        <field name="model">awd.inbound.shipment.ept</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="ship_from_address_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="amazon_awd_inbound_shipment_form_view" model="ir.ui.view">
        <field name="name">amazon.awd.inbound.shipment.form.view</field>
        <field name="model">awd.inbound.shipment.ept</field>
        <field name="arch" type="xml">
            <form string="Shipment" create="false">
                <header>
                    <button name="check_status" string="Check Status" class="oe_highlight capitalize" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="WORKING,READY_TO_SHIP,SHIPPED,CLOSED"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="count_pickings == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="count_pickings"/>
                                    Pickings
                                </span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="oe_inline" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="fulfill_center_id" readonly="1" invisible="1"/>
                            <field name="warehouse_reference_id" readonly="1"/>
                            <field name="destination_address_id" readonly="1"/>
                            <field name="awd_to_warehouse_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="shipment_id" readonly="1"/>
                            <field name="amazon_reference_id" readonly="1"/>
                            <field name="ship_from_address_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <separator string='Shipment Items' colspan="4"/>
                            <field name="awd_shipment_line_ids" nolabel="1"
                                   colspan="4">
                                <form string="Shipment Item">
                                    <group>
                                        <group>
                                            <field name="amazon_product_id"/>
                                            <field name="seller_sku"/>
                                        </group>
                                        <group>
                                            <field name="fn_sku"/>
                                            <field name="quantity"/>
                                            <field name="received_qty"/>
                                            <field name="difference_qty"/>
                                            <field name="is_extra_line"/>
                                        </group>
                                    </group>
                                </form>
                                <list delete="0" create="0" editable="top"
                                      decoration-success="is_extra_line==True" decoration-danger="difference_qty!=0">
                                    <field name="amazon_product_id" readonly="1"/>
                                    <field name="quantity"/>
                                    <field name="received_qty" readonly="1"/>
                                    <field name="difference_qty" readonly="1"/>
                                    <field name="seller_sku" readonly="1"/>
                                    <field name="fn_sku" string='FBA(FN) SKU' readonly="1"/>
                                    <field name="is_extra_line" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string='Pickings' invisible="picking_ids == []">
                            <field name="picking_ids" readonly="1" nolabel="1"
                                   colspan="4">
                                <list>
                                    <!--<field name="is_fba_wh_picking" invisible="True"/>-->
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="amazon_shipment_id"/>
                                    <field name="fulfill_center"/>
                                    <field name="state"/>
                                    <field name="total_shipped_qty"/>
                                    <field name="total_received_qty"/>
                                </list>
                            </field>
                        </page>
                        <page string="Error Log">
                            <field name="log_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_amazon_awd_inbound_shipment_ept" model="ir.actions.act_window">
        <field name="name">AWD Inbound Shipments</field>
        <field name="res_model">awd.inbound.shipment.ept</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="amazon_awd_inbound_shipment_search_view"/>
        <field name="help" type="html">
            <p>
                AWD Inbound Shipments are prepared automatically
            </p>
        </field>
    </record>

    <menuitem id="amazon_awd_inbound_shipments_menu" name="AWD Shipments"
              parent="amazon_ept.amazon_inbound_menu_core" sequence="2"
              action="action_amazon_awd_inbound_shipment_ept"
              groups="amazon_ept.group_amazon_fba_ept"/>
</odoo>