<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Azioni pianificate (ir.cron) del connettore BricoBravo. TUTTE DISATTIVE di
        default (active=False): il codice è pronto e installabile, ma nessun
        automatismo parte finché non si attiva dalla UI (Impostazioni → Tecnico →
        Azioni pianificate). I metodi sono orchestratori che riusano la logica già
        validata (pull/push_shipment/generate_*_feed).

        noupdate="1": le modifiche fatte via UI (frequenza, attivazione) NON vengono
        sovrascritte agli aggiornamenti del modulo. Sintassi Odoo 18 (no numbercall,
        no doall): interval_number/interval_type, model_id, state=code, code,
        user_id, active. I valori qui sono solo i DEFAULT di partenza.
    -->
    <data noupdate="1">

        <!-- 1) Pull ordini in entrata (ogni 1 ora di default).
             Riusa l'orchestratore cron_pull_all_channels: per ogni canale attivo
             fa pull → import → conferma → acquired (+ retry_pending_acquired). -->
        <record id="cron_pull_all_channels" model="ir.cron">
            <field name="name">Integrations: scarica ordini (tutti i marketplace)</field>
            <field name="model_id" ref="model_centrivo_channel"/>
            <field name="state">code</field>
            <field name="code">model.cron_pull_all_channels()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="False"/>
        </record>

        <!-- 2) Push spedizioni (ogni 6 ore di default).
             Per gli ordini importati con un picking done + carrier_tracking_ref,
             comunica corriere/tracking. NB: operativo solo quando ShipTracker
             popolerà carrier_tracking_ref (non ancora integrato). -->
        <record id="cron_push_shipments" model="ir.cron">
            <field name="name">Integrations: comunica spedizioni (tutti i marketplace)</field>
            <field name="model_id" ref="model_centrivo_channel"/>
            <field name="state">code</field>
            <field name="code">model.cron_push_shipments()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="False"/>
        </record>

        <!-- 3) Feed prezzi/giacenze (ogni 30 minuti di default). -->
        <record id="cron_generate_stock_feeds" model="ir.cron">
            <field name="name">Integrations: genera feed prezzi/giacenze (CSV)</field>
            <field name="model_id" ref="model_centrivo_channel"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_stock_feeds()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="False"/>
        </record>

        <!-- 4) Feed catalogo completo (ogni 12 ore di default: cambia meno spesso). -->
        <record id="cron_generate_catalog_feeds" model="ir.cron">
            <field name="name">Integrations: genera feed catalogo (CSV)</field>
            <field name="model_id" ref="model_centrivo_channel"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_catalog_feeds()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="False"/>
        </record>

        <!-- 5) ESECUTORE feed catalogo in BACKGROUND (TASK_85, ATTIVO).
             A differenza dei cron OPZIONALI qui sopra (active=False), questo è il
             MOTORE che esegue le generazioni ACCODATE dal bottone "Genera feed
             catalogo ora": deve essere ATTIVO perché l'accodamento parta davvero,
             fuori dal worker WEB (la generazione sincrona rischiava timeout/OOM).
             Elabora UN canale 'pending' per tick e si ri-arma (ir.cron._trigger):
             generazioni back-to-back senza attendere l'intervallo, che resta solo
             una rete di sicurezza. Gemello del cron esecutore dei job di import. -->
        <record id="cron_run_catalog_feed_jobs" model="ir.cron">
            <field name="name">Integrations: esegui generazione feed catalogo (background)</field>
            <field name="model_id" ref="model_centrivo_channel"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_catalog_feed_jobs()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
