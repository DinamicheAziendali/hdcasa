<odoo>
    <record id="view_integration_config_form" model="ir.ui.view">
        <field name="name">centrivo.integration.config.form</field>
        <field name="model">centrivo.integration.config</field>
        <field name="arch" type="xml">
            <form string="Configurazione integrazioni">
                <sheet>
                    <group string="Push spedizioni">
                        <field name="carrier_source_field_id"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="carrier_source_field_name" readonly="1"/>
                    </group>
                    <p class="text-muted">
                        Lasciando vuoto il campo vettore si usa il corriere
                        nativo di Odoo, come prima di questa impostazione.
                        Il codice vettore atteso dal singolo marketplace si
                        configura invece in <b>Mapping Corrieri</b>, che resta
                        per canale.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_integration_config" model="ir.actions.server">
        <field name="name">Configurazione</field>
        <field name="model_id" ref="model_centrivo_integration_config"/>
        <field name="state">code</field>
        <field name="code">action = model.open_config()</field>
    </record>

    <!-- ⚠️ «Configurazione» diventa una TENDINA, non piu' una voce sola.
         La barra era stata accorciata apposta il 2026-08-31: appendere
         «Automazioni» accanto avrebbe rimesso una riga, e sono due cose dello
         stesso mestiere (roba da amministratore, non da tutti i giorni). -->
    <menuitem id="menu_integration_config"
              name="Configurazione"
              parent="menu_integrations_root"
              sequence="90"/>

    <menuitem id="menu_integration_config_impostazioni"
              name="Impostazioni"
              parent="menu_integration_config"
              action="action_integration_config"
              sequence="10"/>
</odoo>
