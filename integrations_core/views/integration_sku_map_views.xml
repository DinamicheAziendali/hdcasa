<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_integration_sku_map_list" model="ir.ui.view">
        <field name="name">centrivo.sku.map.list</field>
        <field name="model">centrivo.sku.map</field>
        <field name="arch" type="xml">
            <list string="Mapping SKU" editable="bottom">
                <field name="channel_id"/>
                <field name="external_code"/>
                <field name="product_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_integration_sku_map" model="ir.actions.act_window">
        <field name="name">Mapping SKU</field>
        <field name="res_model">centrivo.sku.map</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
