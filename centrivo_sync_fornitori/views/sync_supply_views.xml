<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sync_supply_list" model="ir.ui.view">
        <field name="name">centrivo.sync.supply.list</field>
        <field name="model">centrivo.sync.supply</field>
        <field name="arch" type="xml">
            <list string="Disponibilità dropship">
                <field name="supplier_sku"/>
                <field name="product_id"/>
                <field name="dropship_supplier_id"/>
                <field name="qty_available"/>
                <field name="last_sync"/>
                <field name="channel_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sync_supply_form" model="ir.ui.view">
        <field name="name">centrivo.sync.supply.form</field>
        <field name="model">centrivo.sync.supply</field>
        <field name="arch" type="xml">
            <form string="Disponibilità dropship">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="dropship_supplier_id"/>
                            <field name="supplier_sku"/>
                        </group>
                        <group>
                            <field name="qty_available"/>
                            <field name="last_sync"/>
                            <field name="channel_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sync_supply" model="ir.actions.act_window">
        <field name="name">Disponibilità dropship</field>
        <field name="res_model">centrivo.sync.supply</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
