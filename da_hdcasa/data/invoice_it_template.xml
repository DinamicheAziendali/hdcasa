<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="fatturapa_out_oss_fattura_elettronica_body"
        inherit_id="l10n_it_edi.account_invoice_it_FatturaPA_export"
    >
        <xpath expr="//DatiBeniServizi/t[@t-as='tax_line']" position="before">
            <t t-foreach="tax_lines" t-as="oss_tax_data">
                <t
                    t-set="tax_description"
                    t-value="'Aliquota IVA OSS ' + str(oss_tax_data['aliquota_iva']) + '&#37; ' + str(oss_tax_data.get('it_values', {}).get('oss_country_id'))"
                />
                <DettaglioLinee t-if="oss_tax_data.get('it_values', {}).get('oss_country_id')">
                    <NumeroLinea t-out="len(record.mapped('invoice_line_ids')) + 1" />
                    <Descrizione t-out="encode_for_export(tax_description, 1000)" />
                    <Quantita>1.00</Quantita>
                    <UnitaMisura>Units</UnitaMisura>
                    <PrezzoUnitario
                        t-out="format_monetary(oss_tax_data['imposta'], euro)"
                    />
                    <PrezzoTotale
                        t-out="format_monetary(oss_tax_data['imposta'], euro)"
                    />
                    <AliquotaIVA>0.00</AliquotaIVA>
                    <Natura>N2.2</Natura>
                    <AltriDatiGestionali>
                        <TipoDato>OSS</TipoDato>
                        <RiferimentoTesto
                            t-out="encode_for_export(tax_description, 1000)"
                        />
                    </AltriDatiGestionali>
                </DettaglioLinee>
            </t>
        </xpath>
        <xpath expr="//DatiBeniServizi/t[@t-as='tax_line']" position="after">
            <t t-foreach="tax_lines" t-as="oss_tax_data">
                <t
                    t-set="tax_description"
                    t-value="'IVA OSS ' + str(oss_tax_data['aliquota_iva']) + '&#37; ' + str(oss_tax_data.get('it_values', {}).get('oss_country_id'))"
                />
                <DatiRiepilogo t-if="oss_tax_data.get('it_values', {}).get('oss_country_id')">
                    <AliquotaIVA>0.00</AliquotaIVA>
                    <Natura>N2.2</Natura>
                    <ImponibileImporto
                        t-out="format_monetary(oss_tax_data['imposta'], euro)"
                    />
                    <Imposta>0.00</Imposta>
                    <RiferimentoNormativo
                        t-out="encode_for_export(tax_description, 100)"
                    />
                </DatiRiepilogo>
            </t>
        </xpath>
    </template>
</odoo>
