<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_centrivo_channel_form_cdiscount" model="ir.ui.view">
    <field name="name">centrivo.channel.form.cdiscount</field>
    <field name="model">centrivo.channel</field>
    <field name="inherit_id" ref="integrations_core.view_integration_channel_form"/>
    <field name="arch" type="xml">
      <!-- ⚠️ Stessa ragione di Kaufland: Cdiscount non legge mai «Chiave API»
           del nucleo (zero occorrenze nel modulo), le sue credenziali sono
           `cdiscount_client_id` e `cdiscount_client_secret`. Lasciarla in
           vista invita a incollarci la chiave sbagliata. -->
      <field name="api_key" position="attributes">
        <attribute name="invisible">connector_code == 'cdiscount'</attribute>
      </field>
      <notebook position="inside">
        <page string="Cdiscount" name="cdiscount"
              invisible="connector_code != 'cdiscount'">
          <group>
            <group string="Collegamento">
              <field name="cdiscount_client_id"/>
              <field name="cdiscount_client_secret" password="True"/>
              <field name="cdiscount_seller_id"/>
              <!-- Il gettone se lo scrive il connettore. Sta qui perche'
                   quando qualcosa non va e' la prima cosa da guardare: un
                   gettone scaduto e un segreto sbagliato danno lo stesso
                   401. -->
              <field name="cdiscount_gettone" password="True"/>
              <!-- ⚠️ I DUE CAMPI DELLA SCADENZA STANNO INSIEME, e il secondo
                   e' il motivo per cui il primo serve a qualcosa. Il campo
                   vero e' un Float in secondi epoch — cosi' lo scrive e lo
                   legge il connettore — e in schermata si mostra come
                   «1.787.563.200,00»: chi guarda non sa nemmeno dire se sia
                   passato. Quello sotto e' lo stesso istante in data e ora,
                   calcolato e non memorizzato. Vedi
                   models/cdiscount_channel.py. -->
              <field name="cdiscount_gettone_scade"/>
              <field name="cdiscount_gettone_scade_il"/>
            </group>
            <group string="Il collegamento a Octopia">
              <field name="cdiscount_canale_vendita"/>
              <!-- ⚠️ QUESTO CAMPO NON SI TOGLIE DA QUI. Sulla piattaforma
                   esterna la colonna esisteva, la migrazione l'aveva creata
                   e la guardia dell'invio la controllava — e nessuna
                   schermata la scriveva: il bottone non sarebbe mai partito
                   senza una modifica a mano al database. Toglierlo dalla
                   vista rimette il modulo esattamente in quello stato, e non
                   se ne accorge nessuno finche' non si prova a mandare.
                   Vedi il commento sul campo in
                   models/cdiscount_channel.py. -->
              <field name="cdiscount_categoria"/>
              <!-- La raccolta degli esiti. ⚠️ RESTA anche dopo che l'invio
                   delle schede è sparito: gli stessi pacchetti portano le
                   OFFERTE, e questo è il bottone con cui se ne guarda
                   l'esito senza aspettare il giro automatico.

                   ⚠️ Il `groups=` qui NASCONDE, l'`AccessError` nel metodo
                   IMPEDISCE: vanno insieme.

                   ⚠️ E niente `confirm=`: legge e basta. -->
              <button name="action_cdiscount_raccogli_adesso" type="object"
                      string="Raccogli gli esiti adesso"
                      groups="base.group_system"
                      help="Va a riprendere subito l'esito dei pacchetti aperti, senza aspettare il giro automatico. È così che si guarda la prima raccolta vera: l'esito di un pacchetto scade in tre giorni, e il cron va acceso solo dopo che una raccolta è andata pulita."/>
            </group>
          </group>
          <!-- IL RIAGGANCIO. È il primo gesto di ogni giro: le offerte
               nascono dalle schede agganciate, e una scheda che il riaggancio
               non ha visto non esiste per il modulo.

               ⚠️ NIENTE `confirm=`: questo bottone legge e basta. I confirm
               stanno sui gesti che scrivono su Cdiscount. -->
          <group string="Il riaggancio (cosa esiste già su Cdiscount)"
                 name="cdiscount_riaggancio">
            <div colspan="2">
              <button name="action_cdiscount_riaggancia" type="object"
                      string="Riaggancia le schede"
                      groups="base.group_system"
                      class="btn-secondary"
                      help="Legge da Cdiscount i prodotti che possiamo vendere e li accoppia ai prodotti di Odoo per riferimento interno. Non scrive niente su Cdiscount. Va premuto prima di qualunque offerta, e ogni volta che sul portale nascono prodotti nuovi."/>
            </div>
          </group>
          <!-- LE OFFERTE (Consegna 2). I due dati che bloccavano — l'éco-
               participation e il costo di spedizione — stanno qui e sul
               prodotto: finche' mancano, le righe si SALTANO e lo dicono. -->
          <group string="Le offerte (prezzo, giacenza, éco-participation)"
                 name="cdiscount_offerte">
            <group>
              <field name="cdiscount_iva"/>
              <field name="cdiscount_ecotax_obbligatoria"/>
              <field name="cdiscount_modo_consegna"/>
              <field name="cdiscount_spedizione_costo"/>
              <field name="cdiscount_spedizione_costo_aggiuntivo"/>
            </group>
            <group>
              <button name="action_cdiscount_allinea_una" type="object"
                      string="Allinea UNA offerta"
                      groups="base.group_system"
                      class="btn-secondary"
                      confirm="Manda UNA offerta a Cdiscount (prezzo, giacenza, éco-participation, spese). Va poi guardata sul portale. Procedere?"/>
              <button name="action_cdiscount_allinea_offerte" type="object"
                      string="Allinea le offerte"
                      groups="base.group_system"
                      class="btn-primary"
                      confirm="Manda a Cdiscount tutte le offerte cambiate, a pacchetti da 100. Scrive prezzi su un marketplace vero. Procedere?"/>
            </group>
          </group>
          <!-- GLI ORDINI (Consegna 3). Il cancello della spedizione e'
               quello di Kaufland: chiuso, si spedisce solo a mano. -->
          <group string="Gli ordini" name="cdiscount_ordini">
            <group>
              <field name="cdiscount_posizione_fiscale"/>
              <field name="cdiscount_prodotto_spedizione"/>
            </group>
            <group>
              <field name="cdiscount_spedizione_provata" readonly="1"/>
              <field name="cdiscount_spedizione_provata_il" readonly="1"
                     invisible="not cdiscount_spedizione_provata"/>
              <button name="action_cdiscount_apri_cancello_spedizione" type="object"
                      string="Ho verificato sul portale: attiva l'automatismo"
                      class="btn-primary" groups="base.group_system"
                      invisible="cdiscount_spedizione_provata"
                      confirm="Confermi di aver visto SUL PORTALE Cdiscount che l'ordine risulta spedito? Da qui in poi le spedizioni partiranno anche in automatico."/>
              <button name="action_cdiscount_chiudi_cancello_spedizione" type="object"
                      string="Torna al solo invio a mano"
                      groups="base.group_system"
                      invisible="not cdiscount_spedizione_provata"/>
            </group>
          </group>
        </page>
      </notebook>
    </field>
  </record>
</odoo>
