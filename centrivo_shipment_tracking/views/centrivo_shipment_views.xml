<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LISTA spedizioni -->
    <record id="view_centrivo_shipment_list" model="ir.ui.view">
        <field name="name">centrivo.shipment.list</field>
        <field name="model">centrivo.shipment</field>
        <field name="arch" type="xml">
            <list string="Spedizioni tracciate"
                  decoration-danger="is_late or has_open_alert"
                  decoration-muted="lifecycle == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="delivery_carrier_id"/>
                <field name="carrier_tracking_ref"/>
                <field name="status_id"/>
                <field name="lifecycle"/>
                <field name="is_late"/>
                <field name="has_open_alert" optional="show"/>
                <field name="open_alert_count" optional="hide"/>
                <field name="is_claim_candidate" optional="hide"/>
                <field name="dest_country_id" optional="hide"/>
                <field name="dest_state_id" optional="hide"/>
                <field name="dest_zip" optional="hide"/>
                <field name="last_poll_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- FORM spedizione -->
    <record id="view_centrivo_shipment_form" model="ir.ui.view">
        <field name="name">centrivo.shipment.form</field>
        <field name="model">centrivo.shipment</field>
        <field name="arch" type="xml">
            <form string="Spedizione tracciata">
                <header>
                    <button name="action_update_tracking" type="object"
                            string="Aggiorna tracking ora" class="btn-primary"/>
                    <button name="action_resolve_carrier" type="object"
                            string="Risolvi corriere"
                            invisible="not tracker_pending"/>
                    <button name="action_evaluate_sla" type="object"
                            string="Valuta SLA"/>
                    <field name="lifecycle" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object"
                                class="oe_stat_button" icon="fa-truck">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Trasferimento</span>
                            </div>
                        </button>
                        <button name="%(action_centrivo_shipment_alert)d" type="action"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                context="{'search_default_shipment_id': id}">
                            <field name="open_alert_count" widget="statinfo"
                                   string="Alert aperti"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Candidata a reclamo"
                            bg_color="text-bg-warning"
                            invisible="not is_claim_candidate"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="tracker_pending" invisible="1"/>
                    <field name="is_claim_candidate" invisible="1"/>
                    <field name="has_open_alert" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="not tracker_pending">
                        Corriere da assegnare: scegli l'adattatore di tracking nel
                        campo <strong>Corriere (tracker)</strong> qui sotto per
                        poter aggiornare il tracking.
                    </div>
                    <group>
                        <group string="Stato">
                            <field name="status_id"/>
                            <field name="last_status_date"/>
                            <field name="is_late"/>
                            <field name="delay_days"
                                   invisible="not is_late"/>
                            <field name="last_poll_date"/>
                        </group>
                        <group string="Spedizione">
                            <field name="partner_id"/>
                            <field name="delivery_carrier_id"/>
                            <field name="carrier_tracking_ref"/>
                            <field name="tracker_code"
                                   placeholder="Da assegnare"/>
                            <field name="sale_order_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Date">
                            <field name="ship_date"/>
                            <field name="expected_delivery_date"/>
                            <field name="delivered_date"/>
                        </group>
                        <group string="Destinazione">
                            <field name="dest_country_id"/>
                            <field name="dest_state_id"/>
                            <field name="dest_zip"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Colli" name="parcels">
                            <field name="parcel_ids">
                                <list string="Colli">
                                    <field name="tracking_number"/>
                                    <field name="status_id"/>
                                    <field name="status_date"/>
                                    <field name="delivered_date"/>
                                    <field name="last_poll_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Eventi (timeline)" name="events">
                            <field name="event_ids">
                                <list string="Eventi" create="false" edit="false">
                                    <field name="event_datetime"/>
                                    <field name="status_id"/>
                                    <field name="raw_code"/>
                                    <field name="raw_description"/>
                                    <field name="location"/>
                                    <field name="branch_raw"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alert" name="alerts">
                            <field name="alert_ids">
                                <list string="Alert" create="false"
                                      decoration-danger="state == 'open'"
                                      decoration-muted="state in ('resolved', 'ignored')">
                                    <field name="trigger_date"/>
                                    <field name="alert_kind"/>
                                    <field name="name"/>
                                    <field name="trigger_status_id" optional="hide"/>
                                    <field name="rule_id" optional="hide"/>
                                    <field name="suggested_claim"/>
                                    <field name="state"/>
                                    <field name="resolved_date" optional="hide"/>
                                    <button name="action_resolve" type="object"
                                            string="Risolvi" icon="fa-check"
                                            invisible="state != 'open'"/>
                                    <button name="action_ignore" type="object"
                                            string="Ignora" icon="fa-bell-slash"
                                            invisible="state != 'open'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter completa (TASK_64): il modello eredita mail.thread +
                     mail.activity.mixin, quindi il pannello messaggi/note/follower e le
                     attività SLA si renderizzano correttamente. Tag <chatter/> nativo
                     Odoo 18. -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH spedizioni -->
    <record id="view_centrivo_shipment_search" model="ir.ui.view">
        <field name="name">centrivo.shipment.search</field>
        <field name="model">centrivo.shipment</field>
        <field name="arch" type="xml">
            <search string="Spedizioni">
                <field name="name"/>
                <field name="carrier_tracking_ref"/>
                <field name="partner_id"/>
                <field name="delivery_carrier_id"/>
                <field name="status_id"/>
                <filter name="active_lifecycle" string="Attive"
                        domain="[('lifecycle', '=', 'active')]"/>
                <filter name="closed_lifecycle" string="Chiuse"
                        domain="[('lifecycle', '=', 'closed')]"/>
                <filter name="late" string="In ritardo"
                        domain="[('is_late', '=', True)]"/>
                <separator/>
                <filter name="problematic" string="Stato problematico (giacenza/anomalia)"
                        domain="[('status_id.is_problematic', '=', True)]"/>
                <filter name="tracker_pending" string="Corriere da assegnare"
                        domain="[('tracker_pending', '=', True)]"/>
                <separator/>
                <filter name="has_alert" string="Ha alert"
                        domain="[('has_open_alert', '=', True)]"/>
                <filter name="claim_candidate" string="Candidata a reclamo"
                        domain="[('is_claim_candidate', '=', True)]"/>
                <separator/>
                <filter name="alert_missed_pickup" string="Alert: mancata presa in carico"
                        domain="[('alert_type', '=', 'missed_pickup')]"/>
                <filter name="alert_late_delivery" string="Alert: consegna oltre atteso"
                        domain="[('alert_type', '=', 'late_delivery')]"/>
                <filter name="alert_staleness" string="Alert: mancato aggiornamento"
                        domain="[('alert_type', '=', 'staleness')]"/>
                <group expand="0" string="Raggruppa per">
                    <filter name="group_status" string="Stato"
                            context="{'group_by': 'status_id'}"/>
                    <filter name="group_carrier" string="Corriere"
                            context="{'group_by': 'delivery_carrier_id'}"/>
                    <filter name="group_alert_type" string="Tipo alert"
                            context="{'group_by': 'alert_type'}"/>
                    <filter name="group_country" string="Nazione"
                            context="{'group_by': 'dest_country_id'}"/>
                    <filter name="group_lifecycle" string="Ciclo di vita"
                            context="{'group_by': 'lifecycle'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_centrivo_shipment" model="ir.actions.act_window">
        <field name="name">Tracking spedizioni</field>
        <field name="res_model">centrivo.shipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_centrivo_shipment_search"/>
        <field name="context">{'search_default_active_lifecycle': 1}</field>
    </record>
</odoo>
