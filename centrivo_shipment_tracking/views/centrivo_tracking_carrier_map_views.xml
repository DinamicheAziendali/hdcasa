<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_centrivo_tracking_carrier_map_list" model="ir.ui.view">
        <field name="name">centrivo.tracking.carrier.map.list</field>
        <field name="model">centrivo.tracking.carrier.map</field>
        <field name="arch" type="xml">
            <list string="Mappa corrieri → adattatore" multi_edit="1">
                <field name="source_display"/>
                <field name="source_model"/>
                <field name="tracker_code"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_centrivo_tracking_carrier_map_form" model="ir.ui.view">
        <field name="name">centrivo.tracking.carrier.map.form</field>
        <field name="model">centrivo.tracking.carrier.map</field>
        <field name="arch" type="xml">
            <form string="Mappa corriere → adattatore">
                <sheet>
                    <group>
                        <group string="Corriere sorgente">
                            <field name="source_selection"/>
                            <!-- Chiavi durevoli: meccanica interna, compilate da
                                 sole dalla scelta sopra. Nascoste all'utente. -->
                            <field name="source_model" invisible="1"/>
                            <field name="source_res_id" invisible="1"/>
                            <field name="source_display" invisible="1"/>
                        </group>
                        <group string="Adattatore">
                            <field name="tracker_code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Scegli il record corriere in "Seleziona corriere" e
                        l'adattatore di tracking, poi salva: i dati interni
                        (modello/ID/etichetta) si compilano da soli. La lista dei
                        corrieri selezionabili dipende dal CAMPO SORGENTE impostato
                        in <strong>Impostazioni tracking</strong> (di default i metodi
                        di consegna nativi). Più corrieri possono puntare allo stesso
                        adattatore (es. BRT, BRT 100, DPD → brt).
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_centrivo_tracking_carrier_map_search" model="ir.ui.view">
        <field name="name">centrivo.tracking.carrier.map.search</field>
        <field name="model">centrivo.tracking.carrier.map</field>
        <field name="arch" type="xml">
            <search string="Mappa corrieri">
                <field name="source_display"/>
                <field name="tracker_code"/>
                <field name="source_model"/>
                <group expand="0" string="Raggruppa per">
                    <filter name="group_tracker" string="Adattatore"
                            context="{'group_by': 'tracker_code'}"/>
                    <filter name="group_model" string="Modello sorgente"
                            context="{'group_by': 'source_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_centrivo_tracking_carrier_map" model="ir.actions.act_window">
        <field name="name">Mappa corrieri</field>
        <field name="res_model">centrivo.tracking.carrier.map</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_centrivo_tracking_carrier_map_search"/>
    </record>
</odoo>
