<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Record rules multi-AZIENDA (company_id) sui modelli TRANSAZIONALI del
        tracking (spedizione, collo, evento, account). Pattern Odoo standard: rule
        GLOBALE con domain ['|', ('company_id','=',False), ('company_id','in',company_ids)].

        NB: gli stati (centrivo.shipment.status) e la tabella di normalizzazione
        (centrivo.shipment.status.map) sono un CATALOGO di configurazione GLOBALE
        (senza company_id), quindi NON hanno record rule: sono condivisi tra le
        aziende come una definizione di macchina a stati.
    -->
    <record id="centrivo_shipment_company_rule" model="ir.rule">
        <field name="name">centrivo.shipment multi-company</field>
        <field name="model_id" ref="model_centrivo_shipment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="centrivo_shipment_parcel_company_rule" model="ir.rule">
        <field name="name">centrivo.shipment.parcel multi-company</field>
        <field name="model_id" ref="model_centrivo_shipment_parcel"/>
