        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="centrivo_sla_rule_company_rule" model="ir.rule">
        <field name="name">centrivo.sla.rule multi-company</field>
        <field name="model_id" ref="model_centrivo_sla_rule"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="centrivo_shipment_alert_company_rule" model="ir.rule">
