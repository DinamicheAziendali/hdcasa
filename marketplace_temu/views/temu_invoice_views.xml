<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_temu" model="ir.ui.view">
        <field name="name">account.move.form.temu</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_temu_push_invoice" type="object"
                        class="oe_stat_button" icon="fa-cloud-upload"
                        invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted'">
                    <field name="temu_document_sent" widget="statinfo"
                           string="Inviata a Temu"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
