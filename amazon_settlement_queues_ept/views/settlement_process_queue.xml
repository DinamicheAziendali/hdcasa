<?xml version="1.0" ?>
<odoo>

    <record id="amazon_settlement_process_queue_ept_view_ept" model="ir.ui.view">
        <field name="name">Amazon Settlement Queue</field>
        <field name="model">settlement.process.queue.ept</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="settlement_id"/>
                <group expand="0" string="Group By...">
                    <filter name="Settlement Reference" string="Seller"
                            context="{'group_by':'settlement_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="amazon_settlement_process_queue_ept_form_ept" model="ir.ui.view">
        <field name="name">Amazon Settlement Queue</field>
        <field name="model">settlement.process.queue.ept</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Amazon Settlement Queue" create="0" edit="0">
                <sheet>
                    <group>
                        <field name="name" class="oe_inline" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Amazon Settlement Data Line">
                            <field name="settlement_queue_line_ids">
                                <tree create="false" editable="bottom">
                                    <field name="queue_type"/>
                                    <field name="settlement_data"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="amazon_settlement_queue_action" model="ir.actions.act_window">
        <field name="res_model">settlement.process.queue.ept</field>
        <field name="name">Amazon Settlement Queue</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Amazon Settlement Details
            </p>
        </field>
    </record>
</odoo>
