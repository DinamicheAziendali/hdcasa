<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="amazon_settlement_report_form_inherited_view_ept" model="ir.ui.view">
            <field name="name">settlement.report.ept</field>
            <field name="model">settlement.report.ept</field>
            <field name="inherit_id" ref="amazon_ept.amazon_settlement_report_form_view_ept"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/div" position="inside">
                    <button class="oe_inline oe_stat_button" name="settlement_queue" type="object"
                            icon="fa-pencil-square-o" attrs="{'invisible':[('queue_count','=',0)]}">
                        <field string="Settlement Queues"  name="queue_count" widget="statinfo"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
