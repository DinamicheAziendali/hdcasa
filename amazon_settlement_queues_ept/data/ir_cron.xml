<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--This is used for process the settlement queues -->
    <record id="ir_cron_to_create_and_process_settlement_reports" model="ir.cron">
        <field name="name">Auto Process Settlement Queues(Do Not Delete)</field>
        <field name="model_id" ref="model_settlement_process_queue_ept"/>
        <field name="state">code</field>
        <field name="code">model.create_and_process_amazon_settlements()</field>
        <field eval="False" name="active"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="ir_cron_auto_reconcile_settlement_report" model="ir.cron">
        <field name="name">Auto Reconcile Settlement Report(Do Not Delete)</field>
        <field eval="False" name="active"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field eval="False" name="doall"/>
        <field ref="model_settlement_report_ept" name="model_id"/>
        <field name="state">code</field>
        <field name="code">model.auto_reconcile_settlement_report()</field>
    </record>

</odoo>
